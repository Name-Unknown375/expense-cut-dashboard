# Local libSQL/SQLite file for development
DATABASE_URL="file:./dev.db"

# Turso (required on Netlify for persistent data)
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN="your-token"

# Owner password (plain text compared on login)
APP_PASSWORD="your-secure-password"

# Random string used to sign session cookies
SESSION_SECRET="generate-a-long-random-string"

# Google AI Studio (optional) — auto-categorize unknowns + deeper insights
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
